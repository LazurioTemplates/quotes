{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quotes.category.v1",
  "title": "Quotes categories",
  "$comment": "Generated from the Zod schemas of Quotes (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "quotes.category.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
